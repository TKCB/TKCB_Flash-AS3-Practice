	public class Game2 extends Sprite {
		private var _cellSize:int =3D 5;
		private var _grid:Grid;
		private var _player:Sprite;
		private var _index:int;
		private var _path:Array;

		private var tf:Label;
		private var astar:AStar;

		private var path:Sprite =3D new Sprite();
		private var image:Bitmap =3D new Bitmap(new BitmapData(1, 1));
		private var imageWrapper:Sprite =3D new Sprite();

		public function Game2(){
			stage.align =3D StageAlign.TOP_LEFT;
			stage.scaleMode =3D StageScaleMode.NO_SCALE;
			addChild(imageWrapper);
			imageWrapper.addChild(image);
			makePlayer();

			var w:Window =3D new Window(this, 20, 20, "tool");
			numCols =3D new LabelInput("numCols ", "numCols");
			numCols.setValue("50");
			w.add(numCols);
			numRows =3D new LabelInput("numRows ", "numRows");
			w.add(numRows);
			numRows.setValue("50");
			cellSize =3D new LabelInput("cellSize", "cellSize");
			cellSize.setValue("10");
			w.add(cellSize);
			density =3D new LabelInput("density ", "density");
			density.setValue("0.1");
			w.add(density);
			isEight =3D new Checkbox("=E6=98=AF=E5=90=A68=E6=96=B9=E5=90=91");
			isEight.setToggle(true);
			w.add(isEight);
			tf =3D new Label("info");
			w.add(tf);
			w.add(new sliz.miniui.Link("author sliz"));
			w.add(new sliz.miniui.Link("source", =
"http://code.google.com/p/actionscriptiui/"));
			var btn:Button =3D new Button("=E6=96=B0=E5=BB=BA", 0, 0, null, =
newMap);
			w.add(btn, null, 0.8);
			w.setLayout(new BoxLayout(w, 1, 5));
			w.doLayout();
			imageWrapper.addEventListener(MouseEvent.CLICK, onGridClick);
			addEventListener(Event.ENTER_FRAME, onEnterFrame);
			imageWrapper.addChild(path);
			makeGrid();
		}

		private function newMap(e:Event):void {
			makeGrid();
		}

		private function changeMode(e:Event):void {
		/*if (_grid.getType()=3D=3D1) {
		   _grid.calculateLinks(0);
		   (e.currentTarget as Button).text =3D "  =E5=9B=9B=E6=96=B9=E5=90=91 =
 ";
		   }else {
		   _grid.calculateLinks(1);
		   (e.currentTarget as Button).text =3D "  =E5=85=AB=E6=96=B9=E5=90=91 =
 ";
		 }*/
		}

		private function makePlayer():void {
			_player =3D new Sprite();
			_player.graphics.beginFill(0xff00ff);
			_player.graphics.drawCircle(0, 0, 2);
			_player.graphics.endFill();
			imageWrapper.addChild(_player);
		}

		private function makeGrid():void {
			var rows:int =3D int(numRows.getValue());
			var cols:int =3D int(numCols.getValue());
			_cellSize =3D int(cellSize.getValue());
			_grid =3D new Grid(cols, rows);
			for (var i:int =3D 0; i &lt; rows * cols * =
Number(density.getValue()); i++){
				_grid.setWalkable(Math.floor(Math.random() * cols), =
Math.floor(Math.random() * rows), false);
			}
			_grid.setWalkable(0, 0, true);
			_grid.setWalkable(cols / 2, rows / 2, false);
			if (isEight.getToggle())
				_grid.calculateLinks();
			else
				_grid.calculateLinks(1);
			astar =3D new AStar(_grid);
			drawGrid();
			isClick =3D false;
			_player.x =3D 0;
			_player.y =3D 0;
			path.graphics.clear();
		}

		private function drawGrid():void {
			image.bitmapData =3D new BitmapData(_grid.numCols * _cellSize, =
_grid.numRows * _cellSize, false, 0xffffff);
			for (var i:int =3D 0; i &lt; _grid.numCols; i++){
				for (var j:int =3D 0; j &lt; _grid.numRows; j++){
					var node:Node =3D _grid.getNode(i, j);
					if (!node.walkable){
						image.bitmapData.fillRect(new Rectangle(i * _cellSize, j * =
_cellSize, _cellSize, _cellSize), getColor(node));
					}
				}
			}
		}

		private function getColor(node:Node):uint {
			if (!node.walkable)
				return 0;
			if (node =3D=3D _grid.startNode)
				return 0xcccccc;
			if (node =3D=3D _grid.endNode)
				return 0xcccccc;
			return 0xffffff;
		}

		private function onGridClick(event:MouseEvent):void {
			var xpos:int =3D Math.floor(mouseX / _cellSize);
			var ypos:int =3D Math.floor(mouseY / _cellSize);
			xpos =3D Math.min(xpos, _grid.numCols - 1);
			ypos =3D Math.min(ypos, _grid.numRows - 1);
			_grid.setEndNode(xpos, ypos);

			xpos =3D Math.floor(_player.x / _cellSize);
			ypos =3D Math.floor(_player.y / _cellSize);
			_grid.setStartNode(xpos, ypos);
			findPath();
			//path.graphics.clear();
			//path.graphics.lineStyle(0, 0xff0000,0.5);
			//path.graphics.moveTo(_player.x, _player.y);
		}

		private function findPath():void {
			var time:int =3D getTimer();
			if (astar.findPath()){
				_index =3D 0;
				isClick =3D true;

				astar.floyd();
				_path =3D astar.floydPath;
				time =3D getTimer() - time;
				tf.text =3D time + "ms   length:" + astar.path.length;
				trace(astar.floydPath);
				path.graphics.clear();
				for (var i:int =3D 0; i &lt; astar.floydPath.length; i++){
					var p:Node =3D astar.floydPath[i];
					path.graphics.lineStyle(0, 0xff0000);
					path.graphics.drawCircle((p.x + 0.5) * _cellSize, (p.y + 0.5) * =
_cellSize, 2);

					path.graphics.lineStyle(0, 0xff0000, 0.5);
					path.graphics.moveTo(_player.x, _player.y);
				}
			} else {
				time =3D getTimer() - time;
				tf.text =3D time + "ms =E6=89=BE=E4=B8=8D=E5=88=B0";
			}
		}

		private var isClick:Boolean =3D false;
		private var numCols:LabelInput;
		private var numRows:LabelInput;
		private var cellSize:LabelInput;
		private var density:LabelInput;
		private var isEight:Checkbox;

		private function onEnterFrame(event:Event):void {
			if (!isClick){
				return;
			}
			var targetX:Number =3D _path[_index].x * _cellSize + _cellSize / 2;
			var targetY:Number =3D _path[_index].y * _cellSize + _cellSize / 2;
			var dx:Number =3D targetX - _player.x;
			var dy:Number =3D targetY - _player.y;
			var dist:Number =3D Math.sqrt(dx * dx + dy * dy);
			if (dist &lt; 1){
				_index++;
				if (_index &gt;=3D _path.length){
					isClick =3D false;
				}
			} else {
				_player.x +=3D dx * .5;
				_player.y +=3D dy * .5;
				path.graphics.lineTo(_player.x, _player.y);
			}
		}
	}
}

import flash.geom.Point;

class AStar {
	//private var _open:Array;
	private var _open:BinaryHeap;
	private var _grid:Grid;
	private var _endNode:Node;
	private var _startNode:Node;
	private var _path:Array;
	private var _floydPath:Array;
	public var heuristic:Function;
	private var _straightCost:Number =3D 1.0;
	private var _diagCost:Number =3D Math.SQRT2;
	private var nowversion:int =3D 1;

	public function AStar(grid:Grid){
		this._grid =3D grid;
		heuristic =3D euclidian2;

	}

	private function justMin(x:Object, y:Object):Boolean {
		return x.f &lt; y.f;
	}

	public function findPath():Boolean {
		_endNode =3D _grid.endNode;
		nowversion++;
		_startNode =3D _grid.startNode;
		//_open =3D [];
		_open =3D new BinaryHeap(justMin);
		_startNode.g =3D 0;
		return search();
	}

	public function floyd():void {
		if (path =3D=3D null)
			return;
		_floydPath =3D path.concat();
		var len:int =3D _floydPath.length;
		if (len &gt; 2){
			var vector:Node =3D new Node(0, 0);
			var tempVector:Node =3D new Node(0, 0);
			floydVector(vector, _floydPath[len - 1], _floydPath[len - 2]);
			for (var i:int =3D _floydPath.length - 3; i &gt;=3D 0; i--){
				floydVector(tempVector, _floydPath[i + 1], _floydPath[i]);
				if (vector.x =3D=3D tempVector.x &amp;&amp; vector.y =3D=3D =
tempVector.y){
					_floydPath.splice(i + 1, 1);
				} else {
					vector.x =3D tempVector.x;
					vector.y =3D tempVector.y;
				}
			}
		}
		len =3D _floydPath.length;
		for (i =3D len - 1; i &gt;=3D 0; i--){
			for (var j:int =3D 0; j &lt;=3D i - 2; j++){
				if (floydCrossAble(_floydPath[i], _floydPath[j])){
					for (var k:int =3D i - 1; k &gt; j; k--){
						_floydPath.splice(k, 1);
					}
					i =3D j;
					len =3D _floydPath.length;
					break;
				}
			}
		}
	}

	private function floydCrossAble(n1:Node, n2:Node):Boolean {
		var ps:Array =3D bresenhamNodes(new Point(n1.x, n1.y), new Point(n2.x, =
n2.y));
		for (var i:int =3D ps.length - 2; i &gt; 0; i--){
			if (!_grid.getNode(ps[i].x, ps[i].y).walkable){
				return false;
			}
		}
		return true;
	}

	private function bresenhamNodes(p1:Point, p2:Point):Array {
		var steep:Boolean =3D Math.abs(p2.y - p1.y) &gt; Math.abs(p2.x - =
p1.x);
		if (steep){
			var temp:int =3D p1.x;
			p1.x =3D p1.y;
			p1.y =3D temp;
			temp =3D p2.x;
			p2.x =3D p2.y;
			p2.y =3D temp;
		}
		var stepX:int =3D p2.x &gt; p1.x ? 1 : (p2.x &lt; p1.x ? -1 : 0);
		var stepY:int =3D p2.y &gt; p1.y ? 1 : (p2.y &lt; p1.y ? -1 : 0);
		var deltay:Number =3D (p2.y - p1.y) / Math.abs(p2.x - p1.x);
		var ret:Array =3D [];
		var nowX:Number =3D p1.x + stepX;
		var nowY:Number =3D p1.y + deltay;
		if (steep){
			ret.push(new Point(p1.y, p1.x));
		} else {
			ret.push(new Point(p1.x, p1.y));
		}
		while (nowX !=3D p2.x){
			var fy:int =3D Math.floor(nowY)
			var cy:int =3D Math.ceil(nowY);
			if (steep){
				ret.push(new Point(fy, nowX));
			} else {
				ret.push(new Point(nowX, fy));
			}
			if (fy !=3D cy){
				if (steep){
					ret.push(new Point(cy, nowX));
				} else {
					ret.push(new Point(nowX, cy));
				}
			}
			nowX +=3D stepX;
			nowY +=3D deltay;
		}
		if (steep){
			ret.push(new Point(p2.y, p2.x));
		} else {
			ret.push(new Point(p2.x, p2.y));
		}
		return ret;
	}

	private function floydVector(target:Node, n1:Node, n2:Node):void {
		target.x =3D n1.x - n2.x;
		target.y =3D n1.y - n2.y;
	}

	public function search():Boolean {
		var node:Node =3D _startNode;
		node.version =3D nowversion;
		while (node !=3D _endNode){
			var len:int =3D node.links.length;
			for (var i:int =3D 0; i &lt; len; i++){
				var test:Node =3D node.links[i].node;
				var cost:Number =3D node.links[i].cost;
				var g:Number =3D node.g + cost;
				var h:Number =3D heuristic(test);
				var f:Number =3D g + h;
				if (test.version =3D=3D nowversion){
					if (test.f &gt; f){
						test.f =3D f;
						test.g =3D g;
						test.h =3D h;
						test.parent =3D node;
					}
				} else {
					test.f =3D f;
					test.g =3D g;
					test.h =3D h;
					test.parent =3D node;
					_open.ins(test);
					test.version =3D nowversion;
				}

			}
			if (_open.a.length =3D=3D 1){
				return false;
			}
			node =3D _open.pop() as Node;
		}
		buildPath();
		return true;
	}

	private function buildPath():void {
		_path =3D [];
		var node:Node =3D _endNode;
		_path.push(node);
		while (node !=3D _startNode){
			node =3D node.parent;
			_path.unshift(node);
		}
	}

	public function get path():Array {
		return _path;
	}

	public function get floydPath():Array {
		return _floydPath;
	}

	public function manhattan(node:Node):Number {
		return Math.abs(node.x - _endNode.x) + Math.abs(node.y - _endNode.y);
	}

	public function manhattan2(node:Node):Number {
		var dx:Number =3D Math.abs(node.x - _endNode.x);
		var dy:Number =3D Math.abs(node.y - _endNode.y);
		return dx + dy + Math.abs(dx - dy) / 1000;
	}

	public function euclidian(node:Node):Number {
		var dx:Number =3D node.x - _endNode.x;
		var dy:Number =3D node.y - _endNode.y;
		return Math.sqrt(dx * dx + dy * dy);
	}

	private var TwoOneTwoZero:Number =3D 2 * Math.cos(Math.PI / 3);

	public function chineseCheckersEuclidian2(node:Node):Number {
		var y:int =3D node.y / TwoOneTwoZero;
		var x:int =3D node.x + node.y / 2;
		var dx:Number =3D x - _endNode.x - _endNode.y / 2;
		var dy:Number =3D y - _endNode.y / TwoOneTwoZero;
		return sqrt(dx * dx + dy * dy);
	}

	private function sqrt(x:Number):Number {
		return Math.sqrt(x);
	}

	public function euclidian2(node:Node):Number {
		var dx:Number =3D node.x - _endNode.x;
		var dy:Number =3D node.y - _endNode.y;
		return dx * dx + dy * dy;
	}

	public function diagonal(node:Node):Number {
		var dx:Number =3D Math.abs(node.x - _endNode.x);
		var dy:Number =3D Math.abs(node.y - _endNode.y);
		var diag:Number =3D Math.min(dx, dy);
		var straight:Number =3D dx + dy;
		return _diagCost * diag + _straightCost * (straight - 2 * diag);
	}
}

class BinaryHeap {
	public var a:Array =3D [];
	public var justMinFun:Function =3D function(x:Object, y:Object):Boolean =
{
		return x &lt; y;
	};

	public function BinaryHeap(justMinFun:Function =3D null){
		a.push(-1);
		if (justMinFun !=3D null)
			this.justMinFun =3D justMinFun;
	}

	public function ins(value:Object):void {
		var p:int =3D a.length;
		a[p] =3D value;
		var pp:int =3D p &gt;&gt; 1;
		while (p &gt; 1 &amp;&amp; justMinFun(a[p], a[pp])){
			var temp:Object =3D a[p];
			a[p] =3D a[pp];
			a[pp] =3D temp;
			p =3D pp;
			pp =3D p &gt;&gt; 1;
		}
	}

	public function pop():Object {
		var min:Object =3D a[1];
		a[1] =3D a[a.length - 1];
		a.pop();
		var p:int =3D 1;
		var l:int =3D a.length;
		var sp1:int =3D p &lt;&lt; 1;
		var sp2:int =3D sp1 + 1;
		while (sp1 &lt; l){
			if (sp2 &lt; l){
				var minp:int =3D justMinFun(a[sp2], a[sp1]) ? sp2 : sp1;
			} else {
				minp =3D sp1;
			}
			if (justMinFun(a[minp], a[p])){
				var temp:Object =3D a[p];
				a[p] =3D a[minp];
				a[minp] =3D temp;
				p =3D minp;
				sp1 =3D p &lt;&lt; 1;
				sp2 =3D sp1 + 1;
			} else {
				break;
			}
		}
		return min;
	}
}

class Grid {

	private var _startNode:Node;
	private var _endNode:Node;
	private var _nodes:Array;
	private var _numCols:int;
	private var _numRows:int;

	private var type:int;

	private var _straightCost:Number =3D 1.0;
	private var _diagCost:Number =3D Math.SQRT2;

	public function Grid(numCols:int, numRows:int){
		_numCols =3D numCols;
		_numRows =3D numRows;
		_nodes =3D new Array();

		for (var i:int =3D 0; i &lt; _numCols; i++){
			_nodes[i] =3D new Array();
			for (var j:int =3D 0; j &lt; _numRows; j++){
				_nodes[i][j] =3D new Node(i, j);
			}
		}
	}

	/**
	 *
	 * @param	type	0=E5=9B=9B=E6=96=B9=E5=90=91 =
1=E5=85=AB=E6=96=B9=E5=90=91 2=E8=B7=B3=E6=A3=8B
	 */
	public function calculateLinks(type:int =3D 0):void {
		this.type =3D type;
		for (var i:int =3D 0; i &lt; _numCols; i++){
			for (var j:int =3D 0; j &lt; _numRows; j++){
				initNodeLink(_nodes[i][j], type);
			}
		}
	}

	public function getType():int {
		return type;
	}

	/**
	 *
	 * @param	node
	 * @param	type	0=E5=85=AB=E6=96=B9=E5=90=91 =
1=E5=9B=9B=E6=96=B9=E5=90=91 2=E8=B7=B3=E6=A3=8B
	 */
	private function initNodeLink(node:Node, type:int):void {
		var startX:int =3D Math.max(0, node.x - 1);
		var endX:int =3D Math.min(numCols - 1, node.x + 1);
		var startY:int =3D Math.max(0, node.y - 1);
		var endY:int =3D Math.min(numRows - 1, node.y + 1);
		node.links =3D [];
		for (var i:int =3D startX; i &lt;=3D endX; i++){
			for (var j:int =3D startY; j &lt;=3D endY; j++){
				var test:Node =3D getNode(i, j);
				if (test =3D=3D node || !test.walkable){
					continue;
				}
				if (type !=3D 2 &amp;&amp; i !=3D node.x &amp;&amp; j !=3D node.y){
					var test2:Node =3D getNode(node.x, j);
					if (!test2.walkable){
						continue;
					}
					test2 =3D getNode(i, node.y);
					if (!test2.walkable){
						continue;
					}
				}
				var cost:Number =3D _straightCost;
				if (!((node.x =3D=3D test.x) || (node.y =3D=3D test.y))){
					if (type =3D=3D 1){
						continue;
					}
					if (type =3D=3D 2 &amp;&amp; (node.x - test.x) * (node.y - test.y) =
=3D=3D 1){
						continue;
					}
					if (type =3D=3D 2){
						cost =3D _straightCost;
					} else {
						cost =3D _diagCost;
					}
				}
				node.links.push(new Link(test, cost));
			}
		}
	}

	public function getNode(x:int, y:int):Node {
		return _nodes[x][y];
	}

	public function setEndNode(x:int, y:int):void {
		_endNode =3D _nodes[x][y];
	}

	public function setStartNode(x:int, y:int):void {
		_startNode =3D _nodes[x][y];
	}

	public function setWalkable(x:int, y:int, value:Boolean):void {
		_nodes[x][y].walkable =3D value;
	}

	public function get endNode():Node {
		return _endNode;
	}

	public function get numCols():int {
		return _numCols;
	}

	public function get numRows():int {
		return _numRows;
	}

	public function get startNode():Node {
		return _startNode;
	}

}

class Link {
	public var node:Node;
	public var cost:Number;

	public function Link(node:Node, cost:Number){
		this.node =3D node;
		this.cost =3D cost;
	}

}

